# --- Supabase ---------------------------------------------------------------
#
# LOCAL (Docker Supabase): the values below are the well-known defaults
# printed by `supabase start`. They are identical for every local Supabase
# instance and are not secrets — safe to use as-is.
#
# HOSTED (no Docker): create a free project at https://supabase.com, then
# replace every value below with the ones from that project (Project Settings
# -> API for the URL/keys, Project Settings -> Database for the connection
# string) and NEVER commit the real ones. See README.md "Using a hosted
# Supabase project" for the full walkthrough.

# Used by the Next.js app (client + server) for auth and the Data API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. Bypasses RLS. Not currently read by any script or app code —
# reserved for future server-side jobs (Phase 4). Never import it in client
# components and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres connection. Used by `pnpm db:migrate`, `pnpm seed`, and
# `pnpm db:types` — never by the Next.js app itself. For a hosted project,
# use the "URI" connection string from Project Settings -> Database
# (direct connection, not the pooler) — it already includes `sslmode=require`,
# which the migrate/seed/types tooling all honor automatically.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
